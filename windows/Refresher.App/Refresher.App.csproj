<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Official releases add a private brand package in ../../Brand/windows (not in this repository;
    see BRAND.md). Without it, the app builds with a neutral look and the name "AI-ML Refresher".
  -->
  <PropertyGroup>
    <BrandProject>$(MSBuildThisFileDirectory)../../Brand/windows/Brand.Windows.csproj</BrandProject>
    <HasBrand Condition="Exists('$(BrandProject)')">true</HasBrand>
    <!-- Windows builds get native toast notifications; elsewhere (previewing on a Mac) they're off. -->
    <IsWindowsBuild Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))">true</IsWindowsBuild>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(IsWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(IsWindowsBuild)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Refresher</AssemblyName>
    <RootNamespace>Refresher.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <Product>AI-ML Refresher</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasBrand)' == 'true'">
    <DefineConstants>$(DefineConstants);PRIVATE_BRAND</DefineConstants>
    <ApplicationIcon>$(MSBuildThisFileDirectory)../../Brand/windows/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- The toolkit asks for 4.7.0, which has a known vulnerability. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Refresher.Core/Refresher.Core.csproj" />
    <ProjectReference Include="$(BrandProject)" Condition="'$(HasBrand)' == 'true'" />
  </ItemGroup>
</Project>
